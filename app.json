{
  "expo": {
    "name": "Kairos",
    "slug": "personal-assistant",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.kirthi.oracle"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E9E3FF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kirthi.oracle",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_MENSTRUATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": [
      "oracle",
      "com.googleusercontent.apps.113773393811-tmagp12b5fo2o2ghpjjd3nnsvgqu4kbo"
    ],
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#7C6CF2"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Kairos uses your photos to log meals and share images with your coaches.",
          "cameraPermission": "Kairos uses the camera to log your meals."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF7F2",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "603a01a4-fbe1-43f7-9dc1-3865172c32cc"
      }
    },
    "owner": "kikivasshni29"
  }
}
